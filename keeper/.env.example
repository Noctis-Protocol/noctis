# Copy to .env — addresses from noctis-protocol/deployments/sepolia.json

NETWORK=sepolia
CHAIN_ID=11155111
RPC_URL=https://ethereum-sepolia-rpc.publicnode.com

# A4: prefer encrypted keystore (npm run keystore:create) — not plaintext key in prod
KEEPER_PRIVATE_KEY_FILE=./keystores/keeper.json
KEYSTORE_PASSWORD=
REQUIRE_KEYSTORE=1
# Local-only fallback (forbidden when REQUIRE_KEYSTORE=1):
# KEEPER_PRIVATE_KEY=0x...

# Contract addresses — env-first; when empty they fall back to the SSOT file
# noctis-protocol/deployments/sepolia.json (keys contracts.NoctisVault /
# contracts.NoctisExchange — points to the V2 multi-token contracts at cutover)
VAULT_ADDRESS=
EXCHANGE_ADDRESS=
# Quote token: every V2 pair trades against USDC (Circle Sepolia).
# USDT_ADDRESS is the legacy V1 alias and is still read as a fallback.
USDC_ADDRESS=

RELAYER_PORT=3001
POLL_INTERVAL_MS=15000

# Phase A harden
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
RELAYER_RATE_LIMIT_PER_MIN=60
RELAYER_BODY_LIMIT=100kb

# Gas-in-kind refund quote: estimated gas units for one full relayed swap
# (create + request + execute). Quoted to the user, signed in the EIP-712
# intent, skimmed from swap output at settlement (capped by maxGasRefundWei
# on-chain). V2: the refund is paid directly to exchange.gasRecipient
# (relayer float wallet) — no treasury round-trip.
GAS_UNITS_PER_SWAP=2500000

# ─────────────────────────────────────────────────────────────────────────
# Relayer economic anti-grief policy (off-chain, privacy-neutral)
# The gas refund is only collected at settlement — these bound the gas a
# griefer can burn with create/cancel loops. Aggregate stats (never
# vaultIds) at GET /api/relay/policyStats.
# ─────────────────────────────────────────────────────────────────────────
# Max relayed orders per vaultId that are not settled/cancelled yet
RELAY_MAX_INFLIGHT_PER_VAULT=2
# Throttle a vault when settled/(settled+wasted) drops below this ratio…
RELAY_MIN_SETTLE_RATIO=0.5
# …once it has at least this many terminal relayed orders
RELAY_RATIO_MIN_SAMPLE=5
# How long a throttled vault is refused relaying (ms, default 6h)
RELAY_THROTTLE_COOLDOWN_MS=21600000
# In-flight orders older than this count as wasted (ms, default 2h)
RELAY_INFLIGHT_TTL_MS=7200000
# Rolling 24h relayer gas budget in ETH (0 = disabled). Executions that
# collect the refund are never blocked, only new creations/cancels.
RELAY_DAILY_GAS_BUDGET_ETH=0.2
# Policy state file (survives restarts)
# RELAY_POLICY_STATE_PATH=./logs/relay-policy.json

# Persistent stack:
#   docker compose --profile monitor up -d --build
#   docker compose --profile monitor down

# ─────────────────────────────────────────────────────────────────────────
# Monitoring service (npm run monitor / docker compose --profile monitor)
# Addresses & subgraph URL also loaded from noctis-protocol/deployments/sepolia.json
# See MONITORING.md for details.
# ─────────────────────────────────────────────────────────────────────────

# Relayer health endpoint. Inside docker compose the service uses
# http://relayer:3001/api/relay/health automatically; set this only standalone.
# RELAYER_HEALTH_URL=http://127.0.0.1:3001/api/relay/health

# Read RPC for monitor (avoid Flashbots — batch limits). Defaults to publicnode.
MONITOR_RPC_URL=https://ethereum-sepolia-rpc.publicnode.com

# Subgraph query URL (defaults to subgraph.queryUrl from deployments/sepolia.json)
# SUBGRAPH_URL=https://api.studio.thegraph.com/query/1724540/noctis-protocol/v0.9.0

# Relayer EOA to watch (defaults to ops.relayer from deployments/sepolia.json,
# then to the address reported by the relayer health endpoint)
EXPECTED_RELAYER=

# Thresholds
# Alert when relayer ETH balance drops below this (in ETH)
MONITOR_MIN_ETH=0.05
# Alert when subgraph is more than N blocks behind chain head
SUBGRAPH_LAG_BLOCKS=50
# Alert when an order stays PENDING longer than N minutes
STUCK_ORDER_MAX_AGE_MIN=30
# Alert when the chain head does not advance for N ms (RPC stall)
CHAIN_STALL_MS=300000
# Alert when the relayer 24h gas budget is this % consumed
GAS_BUDGET_WARN_PCT=80

# Per-check intervals (ms)
CHECK_HEALTH_INTERVAL_MS=30000
CHECK_RPC_INTERVAL_MS=30000
CHECK_BALANCE_INTERVAL_MS=60000
CHECK_PAUSED_INTERVAL_MS=60000
CHECK_SUBGRAPH_INTERVAL_MS=120000
CHECK_ORDERS_INTERVAL_MS=300000
CHECK_GAS_POLICY_INTERVAL_MS=120000

# Alert channels (any combination; leave empty to disable)
# Discord-compatible webhook — receives POST { "content": "..." }
ALERT_WEBHOOK_URL=
# Legacy alias for ALERT_WEBHOOK_URL (used if ALERT_WEBHOOK_URL is empty)
DISCORD_WEBHOOK_URL=
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Deduplication: the same alert key is not re-sent within this window (ms)
ALERT_COOLDOWN_MS=1800000
# Alert/dedup state file (survives restarts). Docker uses /app/logs/…
# MONITOR_STATE_PATH=./logs/monitor-state.json
# Durable JSONL trail of every alert sent
# ALERT_LOG_PATH=./logs/alerts.jsonl

# Daily heartbeat summary (1 = enabled)
HEARTBEAT_ENABLED=1
HEARTBEAT_INTERVAL_MS=86400000

# HTTP status endpoint (GET /status — bound to 127.0.0.1 on the host)
MONITOR_STATUS_PORT=3002

# Legacy ops-monitor (npm run monitor:legacy) — kept for reference
EXPECTED_FEE_RECIPIENT=
MIN_KEEPER_ETH=0.01
MONITOR_INTERVAL_MS=30000
# Optional: alert if Safe receives no ProtocolFee for N hours (0 = off)
MAX_FEE_SILENCE_HOURS=0
