# Copy to .env — addresses from noctis-protocol/deployments/sepolia.json

NETWORK=sepolia
CHAIN_ID=11155111
RPC_URL=https://ethereum-sepolia-rpc.publicnode.com

# A4: prefer encrypted keystore (npm run keystore:create) — not plaintext key in prod
KEEPER_PRIVATE_KEY_FILE=./keystores/keeper.json
KEYSTORE_PASSWORD=
REQUIRE_KEYSTORE=1
# Local-only fallback (forbidden when REQUIRE_KEYSTORE=1):
# KEEPER_PRIVATE_KEY=0x...

VAULT_ADDRESS=
EXCHANGE_ADDRESS=
USDT_ADDRESS=

RELAYER_PORT=3001
POLL_INTERVAL_MS=15000

# Phase A harden
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
RELAYER_RATE_LIMIT_PER_MIN=60
RELAYER_BODY_LIMIT=100kb

# Gas-in-kind refund quote: estimated gas units for one full relayed swap
# (create + request + execute). Quoted to the user, signed in the EIP-712
# intent, skimmed from swap output at settlement (capped by maxGasRefundWei on-chain).
GAS_UNITS_PER_SWAP=2500000

# Persistent stack:
#   docker compose --profile monitor up -d --build
#   docker compose --profile monitor down

# Ops monitor (npm run monitor) — addresses also loaded from deployments/sepolia.json
EXPECTED_FEE_RECIPIENT=
EXPECTED_RELAYER=
MIN_KEEPER_ETH=0.01
MONITOR_INTERVAL_MS=30000
# Read RPC for monitor (avoid Flashbots — batch limits). Defaults to publicnode.
MONITOR_RPC_URL=https://ethereum-sepolia-rpc.publicnode.com
# Optional: alert if Safe receives no ProtocolFee for N hours (0 = off)
MAX_FEE_SILENCE_HOURS=0
# Alerts (any combination)
DISCORD_WEBHOOK_URL=
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
ALERT_WEBHOOK_URL=
