{
  "name": "@noctis/keeper",
  "version": "0.4.0",
  "description": "Noctis keeper service for processing encrypted withdrawals",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit --skipLibCheck",
    "start": "tsx src/keeper-relayer.ts",
    "start:relayer": "tsx src/keeper-relayer.ts",
    "dev": "tsx src/keeper-relayer.ts",
    "clean": "rimraf dist",
    "test": "echo \"No unit tests yet\"",
    "check-vault": "tsx src/check-vault.ts",
    "add-keeper": "tsx src/add-keeper.ts",
    "monitor": "tsx src/ops-monitor.ts",
    "monitor:ping": "tsx src/ops-monitor.ts --ping",
    "keystore:create": "tsx src/create-keystore.ts"
  },
  "dependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@zama-fhe/relayer-sdk": "0.4.1",
    "cors": "^2.8.6",
    "dotenv": "^16.0.0",
    "ethers": "6.7.1",
    "express": "^5.2.1",
    "winston": "^3.11.0"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "rimraf": "^5.0.0",
    "ts-node": "^10.9.0",
    "tsx": "^4.21.0",
    "typescript": "^5.3.0"
  },
  "engines": {
    "node": ">=20.0.0",
    "npm": ">=9.0.0"
  }
}
