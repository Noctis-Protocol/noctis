# ============================================
# NOCTIS RELAYER — Ethereum mainnet (Phase D)
# ============================================
# Addresses MUST match noctis-protocol/deployments/mainnet.json after deploy

NETWORK=mainnet
CHAIN_ID=1
RPC_URL=https://rpc.ankr.com/eth
# Prefer Flashbots Protect for submitter txs on mainnet
# FLASHBOTS_RPC_URL=https://rpc.flashbots.net

# Prefer keystore (see keeper/src/create-keystore.ts) over plaintext
# KEEPER_KEYSTORE_PATH=./keystore/relayer.json
# KEEPER_KEYSTORE_PASSWORD=...
KEEPER_PRIVATE_KEY=0x...REPLACE_OR_USE_KEYSTORE...

VAULT_ADDRESS=0x…
EXCHANGE_ADDRESS=0x…

RELAYER_PORT=3001
POLL_INTERVAL_MS=12000

# Monitor (read RPC — avoid Flashbots batch limits)
MONITOR_RPC_URL=https://rpc.ankr.com/eth

# Post-deploy:
# 1. RELAYER_ROLE granted via setupTreasuryAndRelayer --network mainnet
# 2. feeRecipient = Safe
# 3. Frontend NEXT_PUBLIC_*_MAINNET synced from SSOT
