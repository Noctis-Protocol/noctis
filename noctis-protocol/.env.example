# Environment Variables

# Private Key (DO NOT COMMIT THE REAL .env FILE)
PRIVATE_KEY=your_private_key_here

# RPC Endpoints
ARBITRUM_SEPOLIA_RPC=https://sepolia-rollup.arbitrum.io/rpc
ARBITRUM_ONE_RPC=https://arb1.arbitrum.io/rpc

# Arbiscan API Key
ARBISCAN_API_KEY=your_arbiscan_api_key_here

# Gas Reporter
REPORT_GAS=true
COINMARKETCAP_API_KEY=your_coinmarketcap_api_key_here

# ZAMA Gateway
ZAMA_GATEWAY_URL=https://gateway.zama.ai

# Uniswap Integration
UNISWAP_V2_ROUTER=0x4752ba5dbc23f44d87826276bf6fd6b1c372ad24  # Arbitrum One/Sepolia
WETH_ADDRESS=0xe39Ab88f8A4777030A534146A9Ca3B52bd5D43A3        # Wrapped ETH (Arbitrum Sepolia)
