{
  "name": "noctis-protocol",
  "version": "0.1.0",
  "description": "The Anti-Frontrunning DEX - Encrypted order book with ZAMA FHE on Ethereum/Arbitrum",
  "author": "Noctis Team",
  "license": "MIT",
  "scripts": {
    "clean": "rimraf artifacts cache coverage typechain-types",
    "compile": "hardhat compile",
    "test": "hardhat test",
    "test:coverage": "SOLIDITY_COVERAGE=true hardhat coverage",
    "test:gas": "REPORT_GAS=true hardhat test",
    "security:slither": "slither . --exclude-dependencies --exclude-informational --exclude-low",
    "security:slither:full": "slither . --exclude-dependencies --print human-summary",
    "deploy:local": "hardhat run scripts/deploy.ts --network localhost",
    "deploy:sepolia": "hardhat run scripts/deployExchange.ts --network sepolia",
    "deploy:v2:sepolia": "hardhat run scripts/deployV2.ts --network sepolia",
    "deploy:v2:mainnet": "hardhat run scripts/deployV2.ts --network mainnet",
    "deploy:zama": "hardhat run scripts/deployExchange.ts --network zamaDevnet",
    "deploy:arbitrum": "hardhat run scripts/deployExchange.ts --network arbitrumSepolia",
    "deploy:mainnet": "hardhat run scripts/deployExchange.ts --network mainnet",
    "deploy:arbitrumOne": "hardhat run scripts/deployExchange.ts --network arbitrumOne",
    "setup:treasury:sepolia": "hardhat run scripts/setupTreasuryAndRelayer.ts --network sepolia",
    "setup:treasury:mainnet": "hardhat run scripts/setupTreasuryAndRelayer.ts --network mainnet",
    "setup:timelock:sepolia": "hardhat run scripts/setupExchangeTimelock.ts --network sepolia",
    "setup:timelock:mainnet": "SKIP_SMOKE=1 hardhat run scripts/setupExchangeTimelock.ts --network mainnet",
    "setup:ownership:sepolia": "hardhat run scripts/transferOwnershipToSafe.ts --network sepolia",
    "setup:ownership:mainnet": "hardhat run scripts/transferOwnershipToSafe.ts --network mainnet",
    "verify:sepolia": "hardhat verify --network sepolia",
    "verify:mainnet": "hardhat verify --network mainnet",
    "verify:arbitrum": "hardhat verify --network arbitrumSepolia"
  },
  "devDependencies": {
    "@fhevm/hardhat-plugin": "^0.4.2",
    "@fhevm/mock-utils": "^0.4.2",
    "@fhevm/solidity": "^0.11.1",
    "@nomicfoundation/hardhat-chai-matchers": "^2.0.0",
    "@nomicfoundation/hardhat-ethers": "^3.1.3",
    "@nomicfoundation/hardhat-network-helpers": "^1.0.0",
    "@nomicfoundation/hardhat-toolbox": "^4.0.0",
    "@nomicfoundation/hardhat-verify": "^2.0.0",
    "@openzeppelin/contracts": "^5.0.0",
    "@typechain/ethers-v6": "^0.5.0",
    "@typechain/hardhat": "^9.0.0",
    "@types/chai": "^4.3.0",
    "@types/mocha": "^10.0.0",
    "@types/node": "^20.0.0",
    "@typescript-eslint/eslint-plugin": "^6.0.0",
    "@typescript-eslint/parser": "^6.0.0",
    "@zama-fhe/relayer-sdk": "^0.4.1",
    "chai": "^4.3.0",
    "dotenv": "^16.0.0",
    "encrypted-types": "^0.0.4",
    "eslint": "^8.0.0",
    "eslint-config-prettier": "^9.0.0",
    "eslint-plugin-prettier": "^5.0.0",
    "ethers": "^6.16.0",
    "hardhat": "^2.28.4",
    "hardhat-gas-reporter": "^1.0.0",
    "prettier": "^3.0.0",
    "prettier-plugin-solidity": "^1.3.0",
    "rimraf": "^5.0.0",
    "solidity-coverage": "^0.8.0",
    "ts-node": "^10.9.0",
    "typechain": "^8.3.0",
    "typescript": "^5.3.0"
  },
  "keywords": [
    "noctis",
    "dex",
    "fhe",
    "zama",
    "arbitrum",
    "encrypted",
    "anti-frontrunning",
    "mev-protection"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/Noctis-Protocol/noctis-protocol"
  }
}
